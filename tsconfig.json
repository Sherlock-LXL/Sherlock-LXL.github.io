{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "Bundler", "strict": true,
    "skipLibCheck": true, "noEmit": true, "noUnusedLocals": true, "resolveJsonModule": true,
    "allowJs": true, "esModuleInterop": true
  },
  "include": ["src", "shared", "modules/**/*.ts"]
}
